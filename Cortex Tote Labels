// ==UserScript==
// @name         Cortex - Tote / Driver Aid beside stop route code (v2)
// @namespace    cortex-tote-aid
// @version      2.5.1
// @description  Shows tote name / driver aid next to the route code (e.g. CX80, MX12) on every collapsed stop of a route, without opening the stop. Colored by delivery status.
// @match        https://logistics.amazon.com/internal/operations/execution/*
// @match        https://logistics.amazon.com/operations/execution/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

/* jshint esversion: 11, browser: true */

function tmToteMain() {
  'use strict';
  if (window.__tmToteV2) return;
  window.__tmToteV2 = true;
  console.log('[Cortex tote v2.2.0] loaded');


  // Status is shared with the button through a DOM attribute, so it works across the sandbox boundary
  let status = '';
  function setBadge(text) {
    status = text;
    if (document.documentElement) document.documentElement.dataset.tmToteStatus = text;
  }
  const markLoaded = () => {
    if (!document.documentElement) return setTimeout(markLoaded, 10);
    document.documentElement.dataset.tmToteLoaded = '1';
    document.documentElement.dataset.tmToteStatus = status || 'hook installed, waiting for route data';
  };
  markLoaded();
  document.addEventListener('tm-tote-render', () => {
    if (waiting) { const w = waiting; waiting = null; fetchBags(w.routeId, w.ids); }
    schedule();
  });  const API = '/internal/operations/execution/api/';
  // Internal and external Cortex use different path prefixes, so learn it from the page's own route request
  let TR_URL = API + 'tasks/trDetails';
  const CHUNK = 200;

  const COLORS = {
    NVY: 'Navy', GRN: 'Green', BLK: 'Black', YLO: 'Yellow', ORG: 'Orange', BLU: 'Blue', RED: 'Red',
    PRP: 'Purple', PNK: 'Pink', WHT: 'White', GRY: 'Gray', BRN: 'Brown',
  };
  // Stop route codes are letters followed by digits (CX80, MX12, SA5...); the prefix set varies by route type
  const ROUTE_CODE_RE = /^[A-Z]{2,3}\d{1,4}\b/;
  const BAG_RE = /(\d+)[-_]([A-Za-z]+)$/; // NA_ST-CN-7552_GRN -> Green 7552, AQ-K-9149-149-NVY -> Navy 149

  const toteName = (bag) => {
    if (!bag) return null;
    const m = bag.match(BAG_RE);
    if (!m) return bag;
    return (COLORS[m[2].toUpperCase()] || m[2]) + ' ' + m[1];
  };

  // State: routes[routeId] = { code, stops: { seq: [{ trId, da, state }] } }
  const routes = {};
  const bagByTr = {};
  const pending = new Set();
  let trHeaders = null;
  let anyHeaders = null;
  let currentRoute = null;

  const routeIdFromUrl = (u) => {
    const m = String(u).match(/route-details\/([^/?#]+)/);
    return m ? decodeURIComponent(m[1]) : null;
  };
  const routeIdFromPage = () => {
    const m = location.pathname.match(/\/routes\/([^/?#]+)/);
    return m ? decodeURIComponent(m[1]) : null;
  };
  const apiPath = (u) => {
    try { return new URL(u, location.href).pathname; } catch (e) { return String(u); }
  };

  // Remember the last few API calls so the button can show what this page actually does
  const seen = [];
  function recordSeen(kind, u) {
    const path = apiPath(u);
    if (!path.includes('/api/')) return;
    const tag = kind + ' ' + path.replace(/^.*\/api\//, '/api/').slice(0, 40);
    if (seen.includes(tag)) return;
    seen.push(tag);
    if (seen.length > 6) seen.shift();
    if (document.documentElement) document.documentElement.dataset.tmToteSeen = seen.join(' ; ');
  }

  function learnTrUrl(u) {
    const path = apiPath(u);
    const i = path.indexOf('/api/');
    if (i >= 0) TR_URL = path.slice(0, i) + '/api/tasks/trDetails';
  }

  function maybeRouteData(url, text) {
    if (!text || text.indexOf('rmsRouteDetails') < 0) return;
    const rid = routeIdFromUrl(url) || routeIdFromPage();
    if (!rid) return;
    learnTrUrl(url);
    onRouteDetails(rid, text);
  }

  function captureHeaders(h) {
    const key = Object.keys(h).find((k) => k.toLowerCase() === 'x-cortex-hmac-signature');
    if (!key) return;
    anyHeaders = h;
    if (waiting) { const w = waiting; waiting = null; fetchBags(w.routeId, w.ids); }
  }

  // ---- Network hooks: listen only; the page signs its own requests ----
  const xo = XMLHttpRequest.prototype.open;
  const xh = XMLHttpRequest.prototype.setRequestHeader;
  const xs = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function (method, url) {
    this.__tm = { url: String(url), h: {} };
    return xo.apply(this, arguments);
  };
  XMLHttpRequest.prototype.setRequestHeader = function (k, v) {
    if (this.__tm) this.__tm.h[k] = v;
    return xh.apply(this, arguments);
  };
  XMLHttpRequest.prototype.send = function () {
    const t = this.__tm;
    if (t && apiPath(t.url).includes('/api/')) {
      recordSeen('XHR', t.url);
      captureHeaders(t.h);
      this.addEventListener('load', () => {
        try {
          if (this.responseType === '' || this.responseType === 'text') maybeRouteData(t.url, this.responseText);
        } catch (e) { /* ignore */ }
      });
    }
    return xs.apply(this, arguments);
  };

  // Some Cortex pages use fetch instead of XHR: capture signed headers and route data there too
  const origFetch = window.fetch;
  window.fetch = function (input, init) {
    let url = '';
    try {
      url = String((input && input.url) || input);
      if (apiPath(url).includes('/api/')) {
        recordSeen('fetch', url);
        const raw = (init && init.headers) || (input && input.headers);
        if (raw) {
          const h = {};
          if (typeof raw.forEach === 'function' && !Array.isArray(raw)) raw.forEach((v, k) => { h[k] = v; });
          else if (Array.isArray(raw)) raw.forEach(([k, v]) => { h[k] = v; });
          else Object.assign(h, raw);
          captureHeaders(h);
        }
      }
    } catch (e) { /* never break the page's own request */ }
    const p = origFetch.apply(this, arguments);
    try {
      if (url && apiPath(url).includes('/api/')) {
        p.then((res) => res.clone().text().then((txt) => maybeRouteData(url, txt)).catch(() => {})).catch(() => {});
      }
    } catch (e) { /* ignore */ }
    return p;
  };

  let waiting = null;

  function onRouteDetails(routeId, text) {
    let d;
    try { d = JSON.parse(text).rmsRouteDetails; } catch (e) { return; }
    if (!d || !d.stops) return;
    const stops = {};
    const need = [];
    for (const s of d.stops) {
      for (const t of s.tasks || []) {
        if (t.taskType !== 'DROP_OFF') continue;
        (stops[s.sequenceNumber] = stops[s.sequenceNumber] || []).push({
          trId: t.referenceId, da: t.driverAssistText, state: t.taskState,
        });
        if (!(t.referenceId in bagByTr)) need.push(t.referenceId);
      }
    }
    // Large routes can arrive in several responses: merge by stop number so later pages never discard earlier stops
    const prev = routes[routeId];
    routes[routeId] = { code: d.routeCode, stops: Object.assign({}, prev && prev.stops, stops) };
    currentRoute = routeId;
    const total = Object.keys(routes[routeId].stops).length;
    console.log('[Cortex tote v2] route data for', d.routeCode, Object.keys(stops).length, 'stops in response,', total, 'known');
    setBadge(d.routeCode + ' data received (' + total + ' stops), loading totes');
    fetchBags(routeId, need);
    schedule();
  }

  async function fetchBags(routeId, ids) {
    const code = routes[routeId].code;
    const todo = ids.filter((id) => !pending.has(id));
    if (!todo.length) {
      if (!ids.length) setBadge(code + ' ready (' + Object.keys(bagByTr).filter((k) => bagByTr[k]).length + ' totes known)');
      return;
    }
    const h = anyHeaders || trHeaders;
    if (!h) {
      console.warn('[Cortex tote v2] no signed headers captured yet');
      waiting = { routeId, ids };
      setBadge('NO signed headers yet - open any stop or click this button to retry');
      return;
    }
    // Drop any content-type the page used so the header is not sent twice
    const headers = {};
    Object.keys(h).forEach((k) => { if (k.toLowerCase() !== 'content-type') headers[k] = h[k]; });
    headers['Content-Type'] = 'application/json';
    todo.forEach((id) => pending.add(id));
    let failure = '';

    // One request for a group of ids; returns '' on success or a short error description
    const post = async (part) => {
      const ctl = new AbortController();
      const to = setTimeout(() => ctl.abort(), 15000);
      try {
        const r = await fetch(TR_URL, {
          method: 'POST',
          headers,
          credentials: 'include',
          signal: ctl.signal,
          body: JSON.stringify({
            trIdAndTaskTypes: part.map((trId) => ({ trId, taskType: 'DROP_OFF' })),
            documentId: routeId,
            documentType: 'RMSRoute',
          }),
        });
        if (!r.ok) {
          let body = '';
          try { body = (await r.text()).replace(/\s+/g, ' ').slice(0, 120); } catch (e) { /* ignore */ }
          return 'HTTP ' + r.status + (body ? ' ' + body : '');
        }
        const j = await r.json();
        const got = new Set();
        (j.trDetails || []).forEach((x) => { bagByTr[x.trId] = toteName(x.bagName); got.add(x.trId); });
        part.forEach((id) => { if (!got.has(id)) bagByTr[id] = null; });
        return '';
      } catch (e) {
        return e && e.name === 'AbortError' ? 'timed out' : String(e && e.message);
      } finally { clearTimeout(to); }
    };

    // A failing group is split in half until the bad ids are isolated, so one bad id cannot block the rest
    let failedIds = 0;
    const run = async (part) => {
      const err = await post(part);
      if (!err) return;
      if (part.length === 1) { failedIds++; failure = failure || err; return; }
      const mid = Math.ceil(part.length / 2);
      await run(part.slice(0, mid));
      await run(part.slice(mid));
    };
    for (let i = 0; i < todo.length; i += CHUNK) await run(todo.slice(i, i + CHUNK));
    if (failedIds && failedIds < todo.length) failure = '';
    else if (failure) failure = 'trDetails ' + failure;

    todo.forEach((id) => pending.delete(id));
    if (failure) {
      console.warn('[Cortex tote v2]', failure);
      waiting = { routeId, ids };
      setBadge(code + ' FAILED: ' + failure + ' - click to retry');
    } else {
      setBadge(code + ' ready (' + todo.filter((id) => bagByTr[id]).length + ' totes found)');
    }
    schedule();
  }
  // ---- Rendering ----
  // Pill background follows the tote color; text color keeps it readable
  const TOTE_STYLE = {
    Navy: ['#1f3a68', '#fff'], Green: ['#2e8b3d', '#fff'], Black: ['#222', '#fff'], Yellow: ['#f6d02f', '#222'],
    Orange: ['#f08a24', '#222'], Blue: ['#2a6fdb', '#fff'], Red: ['#d33', '#fff'], Purple: ['#7b4bb3', '#fff'],
    Pink: ['#f19ac0', '#222'], White: ['#fff', '#222'], Gray: ['#9aa0a6', '#222'], Brown: ['#7a5230', '#fff'],
  };
  const NA_STYLE = ['#e8eaed', '#3c4043'];
  const STATE_MARK = { DELIVERED: '\u2713 ', YOU_ARE_NEXT: '\u25B6 ' };

  function aidRange(list) {
    const nums = list.map(Number).filter((n) => !Number.isNaN(n)).sort((a, b) => a - b);
    if (nums.length !== list.length) return list.join(',');
    const out = [];
    for (let i = 0; i < nums.length;) {
      let j = i;
      while (j + 1 < nums.length && nums[j + 1] === nums[j] + 1) j++;
      out.push(j > i ? nums[i] + '\u2013' + nums[j] : String(nums[i]));
      i = j + 1;
    }
    return out.join(',');
  }

  function pill(tasks) {
    const groups = new Map();
    for (const t of tasks) {
      const bag = bagByTr[t.trId];
      if (bag === undefined) return null;
      const delivered = t.state === 'DELIVERED';
      const name = delivered || !bag ? 'N/A' : bag;
      const key = name + '|' + t.state;
      if (!groups.has(key)) groups.set(key, { name, state: t.state, aids: [] });
      groups.get(key).aids.push(t.da);
    }
    return [...groups.values()];
  }

  // Cortex stop number for a row. Preferred: class stop-N (0-based). Fallback: the stop number printed on the row.
  function stopSeq(p) {
    for (let a = p; a && a !== document.body; a = a.parentElement) {
      const m = typeof a.className === 'string' && a.className.match(/(?:^|\s)stop-(\d+)(?:\s|$)/);
      if (m) return Number(m[1]) + 1;
    }
    const item = p.closest('.stops-list-item, [class*="stops-list-item"], [role="listitem"], li');
    if (item) {
      const leaf = [...item.querySelectorAll('*')].find((e) => !e.children.length && /^\d{1,3}$/.test(e.textContent.trim()));
      if (leaf) return Number(leaf.textContent.trim());
    }
    return null;
  }

  // Short description of the row's ancestors, shown on the button when a row can't be matched
  function ancestry(p) {
    const out = [];
    for (let a = p, i = 0; a && i < 6; a = a.parentElement, i++) out.push(a.tagName + '.' + String(a.className).split(' ')[0]);
    return out.join('<');
  }

  function render() {
    const r = routes[currentRoute];
    const st = { rows: 0, noClass: 0, noTasks: 0, noTote: 0, placed: 0, route: currentRoute || 'none' };
    const publish = () => { if (document.documentElement) document.documentElement.dataset.tmToteStats = JSON.stringify(st); };
    if (!r) { publish(); return; }
    document.querySelectorAll('p[title]').forEach((p) => {
      if (!ROUTE_CODE_RE.test(p.getAttribute('title'))) return;
      st.rows++;
      const seq = stopSeq(p);
      if (seq === null) {
        st.noClass++;
        if (!st.sample) st.sample = ancestry(p);
        return;
      }
      const tasks = r.stops[seq];
      if (!tasks) { st.noTasks++; return; }
      const groups = pill(tasks);
      if (!groups) { st.noTote++; return; }
      st.placed++;
      const sig = groups.map((g) => g.name + g.state + g.aids.join()).join('~');
      // Append to the code's row container so the pill lands after any time window shown beside the code
      const host = p.parentElement;
      let el = [...host.children].find((c) => c.dataset && c.dataset.tmTote !== undefined);
      if (el && el.dataset.tmTote === sig) return;
      if (!el) {
        el = document.createElement('span');
        el.style.cssText = 'display:inline-flex;gap:4px;flex-wrap:wrap;margin-left:6px;vertical-align:middle';
        host.appendChild(el);
      }
      el.dataset.tmTote = sig;
      el.textContent = '';
      for (const g of groups) {
        const [bg, fg] = TOTE_STYLE[g.name.split(' ')[0]] || NA_STYLE;
        const b = document.createElement('span');
        b.textContent = (STATE_MARK[g.state] || '') + g.name + ' / ' + aidRange(g.aids);
        b.style.cssText = 'font:600 12px/18px sans-serif;padding:0 8px;border-radius:9px;white-space:nowrap;background:'
          + bg + ';color:' + fg + ';border:1px solid rgba(0,0,0,.35)' + (g.state === 'YOU_ARE_NEXT' ? ';box-shadow:0 0 0 2px #1a56c4' : '');
        el.appendChild(b);
      }
    });
    publish();
  }

  let timer = 0;
  function schedule() {
    if (timer) return;
    timer = setTimeout(() => { timer = 0; render(); }, 200);
  }

  function start() {
    new MutationObserver((muts) => {
      for (const m of muts) {
        if (m.target.nodeType === 1 && m.target.dataset && m.target.dataset.tmTote !== undefined) continue;
        if (m.target.parentElement && m.target.parentElement.dataset && m.target.parentElement.dataset.tmTote !== undefined) continue;
        schedule();
        return;
      }
    }).observe(document.body, { childList: true, subtree: true });
  }
  if (document.body) start();
  else document.addEventListener('DOMContentLoaded', start);
}

// Run inside the page itself: Tampermonkey can sandbox the script, and a sandboxed
// XMLHttpRequest never sees the page's own Cortex requests.
(function () {
  'use strict';
  const code = '(function () {' + tmToteMain.toString().replace(/^function tmToteMain\(\) \{/, '').replace(/\}\s*$/, '') + '})();';
  const inject = () => {
    const root = document.documentElement || document.head;
    if (!root) return false;
    const s = document.createElement('script');
    s.textContent = code;
    root.appendChild(s);
    s.remove();
    return true;
  };
  try {
    if (!inject()) document.addEventListener('readystatechange', inject, { once: true });
  } catch (e) {
    console.error('[Cortex tote v2] injection failed', e);
  }

  // Always-visible button: proves the userscript is running, shows status, and (re)runs the tool
  const makeButton = () => {
    if (!document.body || document.getElementById('tm-tote-btn')) return;
    const btn = document.createElement('button');
    btn.id = 'tm-tote-btn';
    btn.type = 'button';
    btn.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:99999;font:600 12px sans-serif;padding:6px 12px;border-radius:14px;border:1px solid #003c52;background:#fff;color:#003c52;cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,.3)';
    const root = document.documentElement;
    const paint = () => {
      const loaded = root.dataset.tmToteLoaded === '1';
      btn.textContent = 'Run Tote Labels \u2022 ' + (loaded ? (root.dataset.tmToteStatus || 'ready') + (root.dataset.tmToteStats ? ' | ' + root.dataset.tmToteStats : '') + (/waiting|NO signed/.test(root.dataset.tmToteStatus || '') && root.dataset.tmToteSeen ? ' | saw: ' + root.dataset.tmToteSeen : '') : 'hook NOT installed');
    };
    btn.addEventListener('click', () => {
      if (root.dataset.tmToteLoaded !== '1') inject();
      const status = root.dataset.tmToteStatus || '';
      if (/ready|NO signed|FAILED/.test(status)) {
        document.dispatchEvent(new CustomEvent('tm-tote-render'));
        return;
      }
      // No route data was captured: reload so the hook catches Cortex's route request from the start
      btn.textContent = 'Run Tote Labels \u2022 reloading...';
      location.reload();
    });
    paint();
    setInterval(paint, 1000);
    document.body.appendChild(btn);
  };
  if (document.body) makeButton();
  else document.addEventListener('DOMContentLoaded', makeButton);
})();
